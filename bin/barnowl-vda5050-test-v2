#!/usr/bin/env node

import mqtt from 'mqtt';
import BarnowlVda5050, { MqttListener } from '../lib/barnowlvda5050.js';

const CONNECTION_TOPIC = 'vda5050/v2/reelyactive/0001/connection';
const STATE_TOPIC = 'vda5050/v2/reelyactive/0001/state';
const VISUALIZATION_TOPIC = 'vda5050/v2/reelyactive/0001/visualization';

const hostname = process.argv[2] || 'localhost';
const port = process.argv[3] || 1883;
const url = 'mqtt://' + hostname + ':' + port;

let headerId = 0;
let x = 0;
let y = 0;
let theta = 0;
let xv = 0;
let yv = 0;
let omega = 0;

const client = mqtt.connect(url);
client.on("connect", () => {
  const data = { headerId: headerId++,
                 timestamp: new Date().toISOString(),
                 version: "2.0.0",
                 manufacturer: "reelyActive",
                 serialNumber: "0001",
                 connectionState: "ONLINE" };
  console.log(`Publishing message to ${CONNECTION_TOPIC}`);
  client.publish(CONNECTION_TOPIC, JSON.stringify(data));
});

const barnowlVda5050 = new BarnowlVda5050();

barnowlVda5050.addListener(MqttListener, { client: client });
barnowlVda5050.on('raddec', (raddec) => {
  console.log(raddec.toFlattened());
});
barnowlVda5050.on('infrastructureMessage', (infrastructureMessage) => {
  console.log(infrastructureMessage);
});


setInterval(publishData, 1000);

function publishData() {
  if(client.connected) {
    x += (Math.random() - 0.5);
    y += (Math.random() - 0.5);
    theta = (Math.random() - 0.5) * 2 * Math.PI;
    xv += (Math.random() - 0.5) / 1000;
    yv += (Math.random() - 0.5) / 1000;
    omega = (Math.random() - 0.5) * 2 * Math.PI / 10;

    const data = {
      headerId: headerId++,
      timestamp: new Date().toISOString(),
      version: "2.0.0",
      manufacturer: "reelyActive",
      serialNumber: "0001",
      agvPosition: {
        x: x,
        y: y,
        theta: theta,
        positionInitialized: true,
        localizationScore: Math.random()
      },
      velocity: { xv: xv, yv: yv, omega: omega }
    };

    const message = JSON.stringify(data);
    const topic = ((data.headerId % 5) === 1) ? STATE_TOPIC :
                                                VISUALIZATION_TOPIC;
    console.log(`Publishing message to ${topic}`);
    client.publish(topic, message);
  }
}

console.log(`barnowl-vda5050 instantiation test with broker at ${url}`);
